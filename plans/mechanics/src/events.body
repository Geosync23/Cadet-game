  <div class="tablewrap"><table>
    <tr><th>Day</th><th>Phase</th><th>Event</th><th>Kind</th><th>The career that day</th></tr>
    <tr><td>0-1</td><td></td><td>—</td><td></td><td>arrival; your first shift (Pillar 4)</td></tr>
    <tr><td>2 Tue</td><td><span class="tag new">P1</span></td><td><b>1. Comet viewing</b> (21:00)</td><td>cozy</td><td>rounds with Torres; Rina's health check; your first laundry (the evening is free)</td></tr>
    <tr><td>3 Wed</td><td></td><td>—</td><td></td><td>hauling, the drill</td></tr>
